# Example Environment Variables for the FastAPI Google Integration App
# Rename this file to .env and fill in your actual values if running the app.

# --- Google OAuth Credentials ---
# Obtain these from your Google Cloud Console project:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# --- API Security ---
# A secret key YOU generate to protect your FastAPI endpoints.
# Use a strong, random string (e.g., generated by a password manager or `openssl rand -hex 32`).
# Send it as the X-API-Key header on API calls. To link your Google account,
# open /auth?key=YOUR_API_KEY in a browser.
API_KEY=YOUR_SECRET_FASTAPI_API_KEY_HERE

# --- Google Account Allowlist ---
# Comma-separated Google account emails allowed to complete the OAuth flow.
# REQUIRED: if empty or unset, every sign-in at /callback is rejected.
# Example: ALLOWED_GOOGLE_EMAILS=you@gmail.com,other@example.com
ALLOWED_GOOGLE_EMAILS=you@gmail.com

# --- Session Management ---
# A secret key for signing session cookies.
# Use a strong, random string.
# Session cookies are HTTPS-only, so serve the app over HTTPS
# (browsers treat http://localhost as secure for local development).
SESSION_SECRET=YOUR_SECRET_SESSION_KEY_HERE

# --- OAuth Callback URL ---
# The URL Google redirects back to after authentication.
# MUST match one of the Authorized redirect URIs in your Google Cloud Console credentials.
# For local development (adjust port if needed):
# REDIRECT_URI=http://localhost:10000/callback
# For production deployment (replace with your actual URL):
REDIRECT_URI=https://your-fastapi-app-url.com/callback

# --- Database ---
# Path where the SQLite database for storing Google tokens will be saved.
# Relative path works for local use. Ensure the directory is writable.
DB_PATH=google_auth_tokens.db

# --- Timezone ---
# Default timezone for date/time operations (IANA format).
# Examples: UTC, America/New_York, Europe/London, America/Vancouver
DEFAULT_TIMEZONE=UTC

# --- Server Port ---
# Port the FastAPI application will listen on locally.
PORT=10000

# --- CORS ---
# Comma-separated list of origins allowed to access the API from a browser.
# Use "*" for development ONLY if necessary. Be specific for production.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional for AI Plugin Manifest ---
# The base URL where this FastAPI application is publicly accessible.
# Used to construct URLs in the plugin manifest.
# Example: API_BASE_URL=https://your-fastapi-app-url.com
API_BASE_URL=http://localhost:10000

# OpenAI Plugin Verification Token (If required by the platform hosting your AI plugin)
# Only needed if you are registering this as a verified plugin (e.g., with OpenAI).
# OPENAI_PLUGIN_VERIFICATION_TOKEN=YOUR_OPENAI_PLUGIN_VERIFICATION_TOKEN_HERE

